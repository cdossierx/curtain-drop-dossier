# Copy to .env and fill in values (never commit .env)
#
# Local dev: npm install && npm run dev
# Production (Render): set these in the Render dashboard Environment tab

# MySQL connection (Alibaba Cloud / PlanetScale-compatible URL)
# Example: mysql://user:password@host:3306/database_name
DATABASE_URL=

# App auth (required in production; can be placeholders for local dev)
APP_ID=
APP_SECRET=

# Kimi OAuth (required in production)
KIMI_AUTH_URL=
KIMI_OPEN_URL=

# Optional
OWNER_UNION_ID=

# Local uploads folder (Render sets UPLOAD_DIR via render.yaml)
# UPLOAD_DIR=./uploads
